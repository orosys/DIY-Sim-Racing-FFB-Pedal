<UserControl x:Class="DiyFfbPedal.UIFunction.LivePlot_ExtendedState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiyFfbPedal.UIFunction"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="720"
             Width="720" Height="850" Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="ModernPillButton" TargetType="Button">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="#D0D0D0"/>
                <Setter Property="BorderBrush" Value="#444444"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
                <Setter Property="Padding" Value="5,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#383838"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#666666"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" Width="716" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,0,0,0">
        
        <!-- Header & Control Bar (Clean 2-row layout fitting under 716px) -->
        <Border Background="#202020" CornerRadius="5" BorderBrush="#333333" BorderThickness="1" Padding="8,5" Width="716">
            <StackPanel Orientation="Vertical">
                <!-- Row 1: Title and Stream Status Badge -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LIVE TELEMETRY PLOTTER" FontFamily="Arial Black" FontSize="13" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                        <TextBlock Text="— Right-click plot to select signals" FontSize="10" Foreground="#888888" Margin="8,2,0,0" VerticalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>
                    
                    <!-- Stream Status Pill (Always visible in top right) -->
                    <Border HorizontalAlignment="Right" Background="#282828" BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ellipse_stream_indicator" Width="7" Height="7" Fill="#757575" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="tb_stream_status" Text="○ Idle" FontSize="10" Foreground="#9E9E9E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: Controls Toolbar -->
                <Grid Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pedal:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                        <Button x:Name="btn_pedal_clutch" Content="Clutch" Tag="0" Click="BtnPedal_Click" Width="52" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,2,0"/>
                        <Button x:Name="btn_pedal_brake" Content="Brake" Tag="1" Click="BtnPedal_Click" Width="52" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,2,0"/>
                        <Button x:Name="btn_pedal_throttle" Content="Throttle" Tag="2" Click="BtnPedal_Click" Width="52" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,8,0"/>

                        <Border Width="1" Height="16" Background="#444444" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <Button x:Name="btn_live_pause" Content="⏸ Pause" Click="BtnLivePause_Click" Width="58" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,3,0"/>
                        <Button x:Name="btn_clear" Content="🗑 Clear" Click="BtnClear_Click" Width="50" Height="22" Style="{StaticResource ModernPillButton}" Margin="0,0,8,0"/>

                        <Border Width="1" Height="16" Background="#444444" Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <TextBlock Text="Win:" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="cb_time_window" Width="52" Height="22" SelectionChanged="CbTimeWindow_SelectionChanged" Margin="0,0,8,0" Background="#2A2A2A" Foreground="White" FontSize="10"/>

                        <CheckBox x:Name="chk_auto_scale" Content="Auto-Scale" IsChecked="True" Checked="ChkAutoScale_Changed" Unchecked="ChkAutoScale_Changed" FontSize="10" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Signals Menu Button (Always right-aligned) -->
                    <Button x:Name="btn_signals_menu" Content="Signals ▾" Click="BtnSignalsMenu_Click" HorizontalAlignment="Right" Width="68" Height="22" Style="{StaticResource ModernPillButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Enlarged Plot Canvas Area (Height 580px, Width 716px) -->
        <Border Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="0,6,0,0" Width="716" Height="580" ClipToBounds="True">
            <Grid x:Name="grid_plot_host">
                <!-- Background Gridlines & Axis Labels -->
                <Canvas x:Name="canvas_grid" Width="714" Height="578" IsHitTestVisible="False"/>
                
                <!-- Main Polyline Trace Canvas with Right-Click Context Menu & Hover Data Tip -->
                <Canvas x:Name="canvas_plot" Width="714" Height="578" Background="Transparent" 
                        SizeChanged="Canvas_plot_SizeChanged"
                        MouseMove="Canvas_plot_MouseMove"
                        MouseLeave="Canvas_plot_MouseLeave">
                    <Canvas.ContextMenu>
                        <ContextMenu x:Name="plot_context_menu" Opened="Plot_context_menu_Opened">
                            <!-- Populated in code-behind with Servo, ESP & Admittance submenus -->
                        </ContextMenu>
                    </Canvas.ContextMenu>
                </Canvas>

                <!-- Vertical Crosshair Cursor Line -->
                <Line x:Name="line_crosshair" X1="0" Y1="0" X2="0" Y2="578" Stroke="#66FFFFFF" StrokeDashArray="3,3" StrokeThickness="1" IsHitTestVisible="False" Visibility="Collapsed"/>

                <!-- Hover Data Tip Floating Card -->
                <Border x:Name="card_datatip" Background="#EE161616" BorderBrush="#4A4A4A" BorderThickness="1" CornerRadius="4" Padding="7,5" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="tb_datatip_time" Text="Time: -0.00s" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                        <StackPanel x:Name="sp_datatip_items" Orientation="Vertical"/>
                    </StackPanel>
                </Border>

                <!-- No signals placeholder text -->
                <TextBlock x:Name="tb_no_signals_hint" Text="Right-click canvas to select signals to plot" Foreground="#444444" FontSize="13" FontFamily="Segoe UI, Arial" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Compact Active Signals & Legend Card (Height 100px) -->
        <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Margin="0,6,0,0" Width="716" Height="100" Padding="8,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,0,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE SIGNALS" FontFamily="Arial Black" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                        <TextBlock x:Name="tb_active_count" Text="(0 active)" FontSize="10" Foreground="#666666" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear All" Click="BtnClearAllSignals_Click" FontSize="9" Style="{StaticResource ModernPillButton}" Padding="5,1" Height="18" Margin="0,0,3,0"/>
                        <Button Content="Reset Defaults" Click="BtnResetDefaultSignals_Click" FontSize="9" Style="{StaticResource ModernPillButton}" Padding="5,1" Height="18"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="panel_legends" Orientation="Horizontal" Margin="0,2,0,0"/>
                </ScrollViewer>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>