<UserControl x:Class="DiyFfbPedal.UIFunction.SystemSetting_Wireless"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d" 
             d:DesignHeight="183" d:DesignWidth="540">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DiyFfbPedal;component/UIStyles/DefaultStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Name="TableActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="19"/>
                <Setter Property="MinWidth" Value="24"/>
                <Setter Property="FontSize" Value="8"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#44FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="#7F4E4E4E" Height="177" CornerRadius="5,5,5,5" BorderThickness="0,2,0,0" Padding="5,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Header & Toolbar -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="2,1,2,2">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <!-- Wi-Fi vector icon -->
                        <Canvas Width="14" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Path Data="M1,2.5 A9,9 0 0,1 13,2.5 M3,5.5 A6,6 0 0,1 11,5.5 M5.5,8.5 A3,3 0 0,1 8.5,8.5" Stroke="#00E5FF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            <Ellipse Width="2" Height="2" Fill="#00E5FF" Canvas.Left="6" Canvas.Top="9"/>
                        </Canvas>
                        <TextBlock Text="WIRELESS PEDALS &amp; SPECTRUM" FontFamily="Arial Black" FontSize="9.5" Foreground="#00E5FF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- Active Wi-Fi Channel Badge -->
                        <Border Background="#2200E5FF" BorderBrush="#5500E5FF" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0" VerticalAlignment="Center">
                            <TextBlock x:Name="tb_active_channel_badge" Text="Active: Ch 11" FontFamily="Consolas" FontSize="8.5" Foreground="#00FFCC" FontWeight="Bold"/>
                        </Border>

                        <!-- Scan All Channels Action Button -->
                        <Button x:Name="btn_scan_all_channels" Click="btn_scan_all_channels_Click" Content="🔍 Scan All Channels" Height="20" Padding="6,0" Background="#2600AAFF" Foreground="#00CCFF" BorderBrush="#3300CCFF" BorderThickness="1" FontSize="8.5" FontFamily="Arial" FontWeight="SemiBold" Cursor="Hand" ToolTip="Sequentially scans Wi-Fi channels 1 through 13 for pedal transmissions"/>

                        <!-- Channel Manual Switcher -->
                        <TextBlock Text="Ch:" FontFamily="Arial" FontSize="8" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        <ComboBox x:Name="combo_select_channel" Width="48" Height="20" FontSize="8" VerticalAlignment="Center" Padding="2,0">
                            <ComboBoxItem Content="Ch 1" Tag="1"/>
                            <ComboBoxItem Content="Ch 2" Tag="2"/>
                            <ComboBoxItem Content="Ch 3" Tag="3"/>
                            <ComboBoxItem Content="Ch 4" Tag="4"/>
                            <ComboBoxItem Content="Ch 5" Tag="5"/>
                            <ComboBoxItem Content="Ch 6" Tag="6"/>
                            <ComboBoxItem Content="Ch 7" Tag="7"/>
                            <ComboBoxItem Content="Ch 8" Tag="8"/>
                            <ComboBoxItem Content="Ch 9" Tag="9"/>
                            <ComboBoxItem Content="Ch 10" Tag="10"/>
                            <ComboBoxItem Content="Ch 11" Tag="11" IsSelected="True"/>
                            <ComboBoxItem Content="Ch 12" Tag="12"/>
                            <ComboBoxItem Content="Ch 13" Tag="13"/>
                        </ComboBox>
                        <Button x:Name="btn_set_channel" Click="btn_set_channel_Click" Content="Set" Width="30" Height="20" Margin="3,0,0,0" Background="#3300E676" Foreground="#00E676" BorderBrush="#5500E676" BorderThickness="1" FontSize="8" FontFamily="Arial" FontWeight="Bold" Cursor="Hand" ToolTip="Switch Master &amp; Pedals to selected channel"/>
                    </StackPanel>
                </DockPanel>

                <!-- Status & Progress Banner -->
                <Grid Grid.Row="1" Margin="2,1,2,3">
                    <Border Background="#15000000" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="3" Padding="5,2">
                        <DockPanel LastChildFill="True">
                            <ProgressBar x:Name="pb_scan_progress" DockPanel.Dock="Right" Width="80" Height="8" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Minimum="1" Maximum="13" Value="1"/>
                            <TextBlock x:Name="tb_scan_status" Text="Live wireless monitor active. Table updates in real-time." FontFamily="Consolas" FontSize="7.5" Foreground="#AAAAAA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Main Pedals Table -->
                <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Margin="2,0,2,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header with clearly separated columns -->
                        <Border Grid.Row="0" Background="#282828" BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" CornerRadius="3,3,0,0">
                            <Grid Margin="4,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PEDAL ROLE" FontFamily="Arial Black" FontSize="7.5" Foreground="#888888" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" BorderBrush="#22FFFFFF" BorderThickness="1,0,1,0">
                                    <TextBlock Text="CHANNEL" FontFamily="Arial Black" FontSize="7.5" Foreground="#00E5FF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="MAC ADDRESS" FontFamily="Arial Black" FontSize="7.5" Foreground="#888888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="ROLE ASSIGNMENT" FontFamily="Arial Black" FontSize="7.5" Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="STATUS" FontFamily="Arial Black" FontSize="7.5" Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="RSSI" FontFamily="Arial Black" FontSize="7.5" Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                            </Grid>
                        </Border>

                        <!-- Table Rows (ScrollViewer) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ic_pedal_list">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1" Padding="4,3" Background="{Binding RowBackground}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74"/>
                                                    <ColumnDefinition Width="62"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Pedal Role Badge -->
                                                <Border Grid.Column="0" Background="{Binding RoleBadgeBackground}" BorderBrush="{Binding RoleBadgeBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RoleName}" FontFamily="Arial Black" FontSize="8" Foreground="{Binding RoleBadgeForeground}"/>
                                                </Border>

                                                <!-- WiFi Channel (Distinct badge, always showing actually used channel) -->
                                                <Border Grid.Column="1" Background="#1A00E5FF" BorderBrush="#3300E5FF" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ChannelDisplay}" FontFamily="Consolas" FontSize="8" Foreground="#00E5FF" FontWeight="Bold"/>
                                                </Border>

                                                <!-- MAC Address (Clearly separated from Channel) -->
                                                <TextBlock Grid.Column="2" Text="{Binding MacAddress}" FontFamily="Consolas" FontSize="8" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>

                                                <!-- Role Assignment Action Buttons -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="Clutch" Click="btn_assign_clutch_Click" Tag="{Binding}" Height="18" FontSize="7.5" FontFamily="Arial" FontWeight="Bold" Margin="1,0" Padding="3,0" Background="#222979FF" Foreground="#2979FF" BorderBrush="#442979FF" BorderThickness="1" Cursor="Hand" ToolTip="Assign this pedal as Clutch"/>
                                                    <Button Content="Brake" Click="btn_assign_brake_Click" Tag="{Binding}" Height="18" FontSize="7.5" FontFamily="Arial" FontWeight="Bold" Margin="1,0" Padding="3,0" Background="#2200E676" Foreground="#00E676" BorderBrush="#4400E676" BorderThickness="1" Cursor="Hand" ToolTip="Assign this pedal as Brake"/>
                                                    <Button Content="Throttle" Click="btn_assign_throttle_Click" Tag="{Binding}" Height="18" FontSize="7.5" FontFamily="Arial" FontWeight="Bold" Margin="1,0" Padding="3,0" Background="#2200B0FF" Foreground="#00B0FF" BorderBrush="#4400B0FF" BorderThickness="1" Cursor="Hand" ToolTip="Assign this pedal as Throttle"/>
                                                    <Button Content="Clear" Click="btn_clear_assignment_Click" Tag="{Binding}" Height="18" FontSize="7.5" FontFamily="Arial" Margin="1,0" Padding="3,0" Background="#22FF5252" Foreground="#FF5252" BorderBrush="#44FF5252" BorderThickness="1" Cursor="Hand" ToolTip="Clear pedal assignment" IsEnabled="{Binding CanClear}"/>
                                                    <Button Content="🔔" Click="btn_beep_Click" Tag="{Binding}" Height="18" Width="18" FontSize="8" Margin="1,0" Padding="0" Background="#22FFD600" Foreground="#FFD600" BorderBrush="#44FFD600" BorderThickness="1" Cursor="Hand" ToolTip="Identify pedal (Beep)"/>
                                                </StackPanel>

                                                <!-- Connection Status Badge -->
                                                <Border Grid.Column="4" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="4" Height="4" Fill="{Binding StatusForeground}" Margin="0,0,3,0"/>
                                                        <TextBlock Text="{Binding StatusText}" FontFamily="Arial" FontSize="7.5" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- RSSI Signal Quality -->
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding RssiDisplay}" FontFamily="Consolas" FontSize="8" FontWeight="Bold" Foreground="{Binding RssiForeground}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Border Width="6" Height="10" Background="{Binding RssiBarBrush}" CornerRadius="1" VerticalAlignment="Center" ToolTip="{Binding RssiTooltip}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
