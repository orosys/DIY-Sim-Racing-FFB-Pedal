<UserControl x:Class="DiyFfbPedal.UIFunction.HomeDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="770" Height="860" Background="#FF25282D">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF343B44"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4A535E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="225"/>
            <RowDefinition Height="135"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="115"/>
        </Grid.RowDefinitions>
        <Grid Margin="6,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PEDAL OVERVIEW" Foreground="White" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="Live output and current profile at a glance" Foreground="#FFABB4BE" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#FF343B44" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                <StackPanel><TextBlock Text="ACTIVE PROFILE" Foreground="#FFABB4BE" FontSize="10"/><TextBlock x:Name="ActiveProfile" Text="None" Foreground="White" FontSize="16" FontWeight="SemiBold"/></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="ACCELERATOR" Foreground="#FF62D2BA" FontWeight="Bold"/><TextBlock x:Name="Status2" Text="Disconnected" Foreground="#FFABB4BE" FontSize="11" Margin="0,5,0,0"/><TextBlock x:Name="Value2" Text="0%" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,6,0,2"/><ProgressBar x:Name="Bar2" Maximum="100" Height="10" Foreground="#FF62D2BA" Background="#FF1D2228"/><TextBlock x:Name="Config2" Text="Force / travel —" Foreground="#FFCCD2D9" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Effects2" Text="Effects: none" Foreground="#FFABB4BE" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="BRAKE" Foreground="#FFFFAA75" FontWeight="Bold"/><TextBlock x:Name="Status1" Text="Disconnected" Foreground="#FFABB4BE" FontSize="11" Margin="0,5,0,0"/><TextBlock x:Name="Value1" Text="0%" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,6,0,2"/><ProgressBar x:Name="Bar1" Maximum="100" Height="10" Foreground="#FFFFAA75" Background="#FF1D2228"/><TextBlock x:Name="Config1" Text="Force / travel —" Foreground="#FFCCD2D9" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Effects1" Text="Effects: none" Foreground="#FFABB4BE" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="CLUTCH" Foreground="#FF9DB7FF" FontWeight="Bold"/><TextBlock x:Name="Status0" Text="Disconnected" Foreground="#FFABB4BE" FontSize="11" Margin="0,5,0,0"/><TextBlock x:Name="Value0" Text="0%" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,6,0,2"/><ProgressBar x:Name="Bar0" Maximum="100" Height="10" Foreground="#FF9DB7FF" Background="#FF1D2228"/><TextBlock x:Name="Config0" Text="Force / travel —" Foreground="#FFCCD2D9" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Effects0" Text="Effects: none" Foreground="#FFABB4BE" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="LIVE PEDAL OUTPUT" Foreground="White" FontWeight="Bold"/><TextBlock Text="● ACCELERATOR    ● BRAKE    ● CLUTCH" HorizontalAlignment="Right" Foreground="#FFABB4BE" FontSize="10"/></Grid>
                <Border Grid.Row="1" Background="#FF232A31" CornerRadius="6" Margin="0,8,0,0" ClipToBounds="True"><Viewbox Stretch="Fill"><Canvas Width="700" Height="78"><Line X1="0" X2="700" Y1="39" Y2="39" Stroke="#334F5964"/><Polyline x:Name="Graph2" Stroke="#FF62D2BA" StrokeThickness="2.5"/><Polyline x:Name="Graph1" Stroke="#FFFFAA75" StrokeThickness="2.5"/><Polyline x:Name="Graph0" Stroke="#FF9DB7FF" StrokeThickness="2.5"/></Canvas></Viewbox></Border>
            </Grid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="90"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                <TextBlock Text="QUICK PROFILES" Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock Grid.Row="1" Text="Apply saved pedal settings and effects in one click" Foreground="#FFABB4BE" FontSize="11" Margin="0,4,0,5"/>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Button x:Name="Quick0" Grid.Column="0" Grid.Row="0" Style="{StaticResource QuickButton}" Content="Profile 1 Apply" Tag="0" Click="QuickApply_Click"/><Button x:Name="Quick1" Grid.Column="1" Grid.Row="0" Style="{StaticResource QuickButton}" Content="Profile 2 Apply" Tag="1" Click="QuickApply_Click"/><Button x:Name="Quick2" Grid.Column="2" Grid.Row="0" Style="{StaticResource QuickButton}" Content="Profile 3 Apply" Tag="2" Click="QuickApply_Click"/><Button x:Name="Quick3" Grid.Column="0" Grid.Row="1" Style="{StaticResource QuickButton}" Content="Profile 4 Apply" Tag="3" Click="QuickApply_Click"/><Button x:Name="Quick4" Grid.Column="1" Grid.Row="1" Style="{StaticResource QuickButton}" Content="Profile 5 Apply" Tag="4" Click="QuickApply_Click"/><Button x:Name="Quick5" Grid.Column="2" Grid.Row="1" Style="{StaticResource QuickButton}" Content="Profile 6 Apply" Tag="5" Click="QuickApply_Click"/>
                </Grid>
                <Border Grid.Row="3" Background="#22232A31" CornerRadius="4" Margin="4,2,4,0" Padding="6,5" MinHeight="38"><TextBlock x:Name="ApplyFeedback" Foreground="#FFB5EFE3" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="15"/></Border>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="SYSTEM STATUS" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="ConnectionSummary" Text="Checking pedal connections…" Foreground="#FFCCD2D9" FontSize="13" Margin="0,8,0,0"/><TextBlock Text="Open a detailed page to tune or manage profiles." Foreground="#FFABB4BE" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource QuickButton}" Content="Pedals →" Click="OpenPedals_Click"/><Button Style="{StaticResource QuickButton}" Content="System →" Click="OpenSystem_Click"/></StackPanel></Grid>
        </Border>
    </Grid>
</UserControl>
